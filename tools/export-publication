#!/usr/bin/env python3
"""Copy exactly the curated allowlist into a new publication directory."""
from pathlib import Path
import shutil
import subprocess
import sys

source = Path(__file__).resolve().parents[1]
destination = Path(sys.argv[1]).expanduser().resolve() if len(sys.argv) > 1 else None
if destination is None:
    raise SystemExit("usage: tools/export-publication DESTINATION")
if destination == source or source in destination.parents or destination in source.parents:
    raise SystemExit("destination must be separate from the source checkout")
if destination.exists() and any(destination.iterdir()):
    raise SystemExit("destination must not exist or must be empty")
allowlist = source / "PUBLICATION.allowlist"
entries = [line.strip() for line in allowlist.read_text().splitlines() if line.strip() and not line.startswith("#")]
for rel in entries:
    src = source / rel
    if src.is_symlink() or not src.is_file() or source not in src.resolve().parents:
        raise SystemExit(f"missing, symlinked, or escaping allowlisted file: {rel}")
destination.mkdir(parents=True, exist_ok=True)
for rel in entries:
    target = destination / rel
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source / rel, target)
    target.chmod((source / rel).stat().st_mode & 0o777)
subprocess.run([sys.executable, str(destination / "tools/verify-publication"), str(destination)], check=True)
print(destination)
