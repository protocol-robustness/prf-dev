{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol-robustness.github.io/prf-dev/schemas/routine-trust-policy.v1",
  "title": "Independent routine-development signing policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "principals"],
  "properties": {
    "schema": {"const": "prf-dev.routine-trust-policy.v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "principals": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["public_key", "roles", "repositories", "status"],
        "properties": {
          "public_key": {"type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/]+={0,2}$"},
          "roles": {"type": "array", "minItems": 1, "items": {"enum": ["routine-coder", "routine-reviewer", "routine-stager"]}},
          "repositories": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["active", "revoked", "retired"]}
        }
      }
    }
  }
}
