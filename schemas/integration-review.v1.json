{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prf-dev.integration-review.v1",
  "title": "Independent review of one exact staging candidate range",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source_commit",
    "target_commit",
    "source_tree",
    "target_tree",
    "reviewed_commits",
    "reviewer",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "prf-dev.integration-review.v1"
    },
    "status": {
      "const": "approved"
    },
    "source_commit": {
      "$ref": "#/$defs/sha1"
    },
    "target_commit": {
      "$ref": "#/$defs/sha1"
    },
    "source_tree": {
      "$ref": "#/$defs/sha1"
    },
    "target_tree": {
      "$ref": "#/$defs/sha1"
    },
    "reviewed_commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sha1"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
